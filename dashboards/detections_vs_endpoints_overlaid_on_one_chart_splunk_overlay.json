      "dashboardQueries": [
        {
          "name": "3fea9839-8268-4447-8837-460915310bfc",
          "query": "detection.detection.rule_name != \"\"\n$Date = timestamp.get_date(detection.detection_time.seconds, \"Australia/Perth\")\n$Endpoint = detection.collection_elements.references.event.principal.hostname\n\nmatch:\n    $Date\n\noutcome:\n    $Detections = count_distinct(detection.id)\n    // Detections without a hostname would count as one extra \"endpoint\"; subtract that bucket.\n    $Endpoints = count_distinct($Endpoint) - max(if($Endpoint = \"\", 1, 0))\n\norder:\n    $Date asc",
          "input": {
            "relativeTime": {
              "timeUnit": "DAY",
              "startTimeVal": "30"
            }
          },
          "etag": "504e737ef902f3409211706fa058bb1846d331c56ac35ff4ad00f8d5d26c277f",
          "dialect": "YL2"
        },
