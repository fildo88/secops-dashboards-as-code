      "dashboardQueries": [
        {
          "name": "fe11c8d9-ca87-4c0c-9eec-04d6725006a0",
          "query": "detection.detection.rule_name != \"\"\n$Date = timestamp.get_date(detection.detection_time.seconds, \"Australia/Perth\")\n$Endpoint = detection.collection_elements.references.event.principal.hostname\n\nmatch:\n    $Date\n\noutcome:\n    $Detections = count_distinct(detection.id)\n    // Detections without a hostname would count as one extra \"endpoint\"; subtract that bucket.\n    $Endpoints = count_distinct($Endpoint) - max(if($Endpoint = \"\", 1, 0))\n\norder:\n    $Date desc",
          "input": {
            "relativeTime": {
              "timeUnit": "DAY",
              "startTimeVal": "30"
            }
          },
          "etag": "b57297057375777f869483064ae129bf7469d01c8d7de2872238ed572e41a1d3",
          "dialect": "YL2"
        },
