      "dashboardQueries": [
        {
          "name": "a399c419-5bc2-4d67-9d5e-487247ed7a18",
          "query": "rules.archived = false\nrules.live_status = \"ENABLED\"\n\noutcome:\n    $Enabled_Rules = count_distinct(rules.name)\n",
          "input": {
            "relativeTime": {
              "timeUnit": "DAY",
              "startTimeVal": "36500"
            }
          },
          "etag": "6863bffd2f2e26b6f6904676efc1841ae2c4eabd73cb65ee8c8718016883152f",
          "dialect": "YL2"
        },
        {
          "name": "9c745bc1-25f5-45f2-ac72-9f8df4980801",
          "query": "rules.archived = false\nrules.live_status = \"ENABLED\"\nrules.alerting = false\n\noutcome:\n    $Enabled_Not_Alerting = count_distinct(rules.name)\n",
          "input": {
            "relativeTime": {
              "timeUnit": "DAY",
              "startTimeVal": "36500"
            }
          },
          "etag": "1a54cc89d06596250e125cdd55d90ab7efc1d60eac3fd1ffb8ac6ebeb064752a",
          "dialect": "YL2"
        },
        {
          "name": "3d199e88-df04-499e-a724-870d00ca0730",
          "query": "rules.archived = false\nrules.live_status = \"ENABLED\"\n$Rule_Name = rules.display_name\n$Severity = strings.to_upper(rules.severity)\n$Alerting = rules.alerting\n\nmatch:\n    $Rule_Name, $Severity, $Alerting\n\noutcome:\n    $Detections = max(rules.total_detection_count)\n    $Last_Detection = timestamp.get_timestamp(max(rules.latest_detection_time.seconds), \"%Y-%m-%d %H:%M\", \"Australia/Sydney\")\n\norder:\n    $Detections desc\n\nlimit:\n    500\n",
          "input": {
            "relativeTime": {
              "timeUnit": "DAY",
              "startTimeVal": "36500"
            }
          },
          "etag": "5f451e444a1b9ecd620e2d1e3756ba12a99b48405d7d906fa2f399f34ad1191f",
          "dialect": "YL2"
        },
        {
          "name": "a415a734-ecbe-4620-a43f-20964fb97722",
          "query": "rules.archived = false\nrules.live_status != \"ENABLED\"\nrules.alerting = true\n\noutcome:\n    $Alerting_But_Disabled = count_distinct(rules.name)\n",
          "input": {
            "relativeTime": {
              "timeUnit": "DAY",
              "startTimeVal": "36500"
            }
          },
          "etag": "9f4e0b792b12cc65bbfee3baa389297f1b71daab1164fd73337284ea403b1d9d",
          "dialect": "YL2"
        },
        {
          "name": "38b0c000-352f-4f39-97ed-e2bce113991d",
          "query": "rules.archived = false\nrules.live_status = \"ENABLED\"\n$Severity = if(rules.severity = \"\", \"UNSET\", strings.to_upper(rules.severity))\n\nmatch:\n    $Severity\n\noutcome:\n    $Rules = count_distinct(rules.name)\n\norder:\n    $Rules desc\n",
          "input": {
            "relativeTime": {
              "timeUnit": "DAY",
              "startTimeVal": "36500"
            }
          },
          "etag": "9e67c080262521546855e40d79edd6de98312502ba53e8bdc3521219ac6a681b",
          "dialect": "YL2"
        },
        {
          "name": "85a61f1c-7ee6-4ea3-8fb9-8a6f32f8fdd6",
          "query": "rules.archived = false\n$Status = rules.live_status\n$Alerting = if(rules.alerting = true, \"Alerting\", \"Not alerting\")\n\nmatch:\n    $Status, $Alerting\n\noutcome:\n    $Rules = count_distinct(rules.name)\n\norder:\n    $Rules desc\n",
          "input": {
            "relativeTime": {
              "timeUnit": "DAY",
              "startTimeVal": "36500"
            }
          },
          "etag": "16648ef6d13f42b78371884586f93e7b37ed627c93defd5c84375cd95f8d0b64",
          "dialect": "YL2"
        },
        {
