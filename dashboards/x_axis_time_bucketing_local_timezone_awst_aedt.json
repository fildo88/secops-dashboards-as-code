      "dashboardQueries": [
        {
          "name": "2ea18135-f452-4a57-a743-2f470fa27f73",
          "query": "metadata.event_type = \"USER_LOGIN\"\n$Hour_UTC = timestamp.get_timestamp(metadata.event_timestamp.seconds, \"%F %H:00\", \"UTC\")\n$Perth_AWST = timestamp.get_timestamp(metadata.event_timestamp.seconds, \"%I:00 %p %a %b %e\", \"Australia/Perth\")\n$Melbourne_AEDT = timestamp.get_timestamp(metadata.event_timestamp.seconds, \"%I:00 %p %a %b %e\", \"Australia/Melbourne\")\n\nmatch:\n    $Hour_UTC, $Perth_AWST, $Melbourne_AEDT\n\noutcome:\n    $Logins = count(metadata.id)\n\norder:\n    $Hour_UTC desc",
          "input": {
            "relativeTime": {
              "timeUnit": "HOUR",
              "startTimeVal": "24"
            }
          },
          "etag": "285e97a654a4114dca07c359dd7fb8b12ce60b0c4377d8a76ea5df3589adb459",
          "dialect": "YL2"
        },
        {
          "name": "e6cbe205-b3bb-4cf5-80b1-1bc68e2c7fc3",
          "query": "metadata.event_type = \"USER_LOGIN\"\n$Hour_Melbourne = timestamp.get_timestamp(metadata.event_timestamp.seconds, \"%F %H:00\", \"Australia/Melbourne\")\n\nmatch:\n    $Hour_Melbourne\n\noutcome:\n    $Logins = count(metadata.id)\n\norder:\n    $Hour_Melbourne asc",
          "input": {
            "relativeTime": {
              "timeUnit": "DAY",
              "startTimeVal": "7"
            }
          },
          "etag": "8bdffdbac3c137f3af94c7655e744d8ba8518dd23205172fdb17b27ad43f5cba",
          "dialect": "YL2"
        },
        {
          "name": "8719a82d-9b28-40ba-a2d4-dfa5ead3d25a",
          "query": "metadata.event_type = \"USER_LOGIN\"\n$Sort_Key = timestamp.get_timestamp(metadata.event_timestamp.seconds, \"%F %H:00\", \"Australia/Perth\")\n$Time_AWST = timestamp.get_timestamp(metadata.event_timestamp.seconds, \"%I:00 %p %a %b %e\", \"Australia/Perth\")\n\nmatch:\n    $Sort_Key, $Time_AWST\n\noutcome:\n    $Logins = count(metadata.id)\n\norder:\n    $Sort_Key asc",
          "input": {
            "relativeTime": {
              "timeUnit": "HOUR",
              "startTimeVal": "48"
            }
          },
          "etag": "11101ae7a3b3e6eb7da429f26a22622544fbecc6bc37b891a5d420f72a54625d",
          "dialect": "YL2"
        },
        {
          "name": "2ab25d99-d16c-4f79-a63c-19874abf5772",
          "query": "metadata.event_type = \"USER_LOGIN\"\n$Hour = timestamp.get_timestamp(metadata.event_timestamp.seconds, \"HOUR\")\n\nmatch:\n    $Hour\n\noutcome:\n    $Logins = count(metadata.id)\n\norder:\n    $Hour asc",
          "input": {
            "relativeTime": {
