      "dashboardQueries": [
        {
          "name": "c9752d22-05f7-4fa9-b234-7b10e064bdbe",
          "query": "metadata.event_type = \"USER_LOGIN\"\n$Hour = timestamp.get_timestamp(metadata.event_timestamp.seconds, \"HOUR\")\n\nmatch:\n    $Hour\n\noutcome:\n    $Logins = count(metadata.id)\n\norder:\n    $Hour asc",
          "input": {
            "relativeTime": {
              "timeUnit": "DAY",
              "startTimeVal": "7"
            }
          },
          "etag": "e2897d32b78e79e073150f26cbf82419c09ed6e109684b2ccf25d5a3e26699a5",
          "dialect": "YL2"
        },
        {
          "name": "4ca6a0d7-1d92-4108-8db8-3ddff286f2c1",
          "query": "metadata.event_type = \"USER_LOGIN\"\n$Hour_AWST = timestamp.get_timestamp(metadata.event_timestamp.seconds, \"%F %H:00\", \"Australia/Perth\")\n\nmatch:\n    $Hour_AWST\n\noutcome:\n    $Logins = count(metadata.id)\n\norder:\n    $Hour_AWST asc",
          "input": {
            "relativeTime": {
              "timeUnit": "DAY",
              "startTimeVal": "7"
            }
          },
          "etag": "ccf7e550c4843f5f76236baa017ef2fa98d3b8713aa4318c195171ff3ceea783",
          "dialect": "YL2"
        },
        {
          "name": "5815118b-9d53-461a-a141-f118aa367ca2",
          "query": "metadata.event_type = \"USER_LOGIN\"\n$Hour_Of_Day_AWST = timestamp.get_hour(metadata.event_timestamp.seconds, \"Australia/Perth\")\n\nmatch:\n    $Hour_Of_Day_AWST\n\noutcome:\n    $Logins = count(metadata.id)\n\norder:\n    $Hour_Of_Day_AWST asc",
          "input": {
            "relativeTime": {
              "timeUnit": "DAY",
              "startTimeVal": "7"
            }
          },
          "etag": "a6c73dc98b639fa8d813729389e5e7bb4bbca931861489f1575dd2db358d2e5b",
          "dialect": "YL2"
        },
        {
          "name": "b40680fe-263f-4672-aa8a-91d90cd88403",
          "query": "metadata.event_type = \"USER_LOGIN\"\n$Hour_UTC = timestamp.get_timestamp(metadata.event_timestamp.seconds, \"%F %H:00\", \"UTC\")\n$Perth_AWST = timestamp.get_timestamp(metadata.event_timestamp.seconds, \"%I:00 %p %a %b %e\", \"Australia/Perth\")\n$Melbourne_AEDT = timestamp.get_timestamp(metadata.event_timestamp.seconds, \"%I:00 %p %a %b %e\", \"Australia/Melbourne\")\n\nmatch:\n    $Hour_UTC, $Perth_AWST, $Melbourne_AEDT\n\noutcome:\n    $Logins = count(metadata.id)\n\norder:\n    $Hour_UTC desc",
          "input": {
            "relativeTime": {
              "timeUnit": "HOUR",
              "startTimeVal": "24"
            }
          },
          "etag": "14938515f4e7117dc755363b61e1e9d83a260dd6f52e8bf742d5f79bbf096a62",
          "dialect": "YL2"
        },
        {
          "name": "6713c1bc-a283-4b59-ac6a-6a42b0c244b6",
          "query": "metadata.event_type = \"USER_LOGIN\"\n$Hour_Melbourne = timestamp.get_timestamp(metadata.event_timestamp.seconds, \"%F %H:00\", \"Australia/Melbourne\")\n\nmatch:\n    $Hour_Melbourne\n\noutcome:\n    $Logins = count(metadata.id)\n\norder:\n    $Hour_Melbourne asc",
          "input": {
            "relativeTime": {
              "timeUnit": "DAY",
              "startTimeVal": "7"
            }
          },
          "etag": "2d9680bf66bef0a8e62b6ed8dba50ac42dbca52fb1b8355abb89b4a53b9fdc34",
          "dialect": "YL2"
        },
        {
          "name": "5b511342-c056-41d1-a533-9b8b7bb2afe3",
          "query": "metadata.event_type = \"USER_LOGIN\"\n$Sort_Key = timestamp.get_timestamp(metadata.event_timestamp.seconds, \"%F %H:00\", \"Australia/Perth\")\n$Time_AWST = timestamp.get_timestamp(metadata.event_timestamp.seconds, \"%I:00 %p %a %b %e\", \"Australia/Perth\")\n\nmatch:\n    $Sort_Key, $Time_AWST\n\noutcome:\n    $Logins = count(metadata.id)\n\norder:\n    $Sort_Key asc",
          "input": {
            "relativeTime": {
              "timeUnit": "HOUR",
              "startTimeVal": "48"
